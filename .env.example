# ResolveAI Configuration
# Copy this to .env and adjust values

# Database
DATABASE_URL=sqlite:///./resolveai.db

# Model Configuration
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
MODEL_PATH=./models/adapters/resolveai-support-v0.1

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG
FAISS_INDEX_PATH=./data/processed/faiss_index
BM25_INDEX_PATH=./data/processed/bm25_index.pkl
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# Confidence Thresholds
CONFIDENCE_HIGH=80
CONFIDENCE_MEDIUM=60

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:8000

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
CORS_ORIGINS=http://localhost:5173
